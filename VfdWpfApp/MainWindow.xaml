<Window x:Class="VfdWpfApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:VfdWpfApp.ViewModels"
        xmlns:sys="clr-namespace:System;assembly=System.Runtime"
        mc:Ignorable="d"
        Title="VFD Window App" Height="820" Width="1180"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <ObjectDataProvider x:Key="UsageModes" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="vm:ParameterUsageMode" />
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
        <ObjectDataProvider x:Key="ActionTypes" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="vm:ParameterActionType" />
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
    </Window.Resources>

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Grid Margin="12">
        <!-- Settings Page -->
        <Grid Visibility="{Binding IsSettingsPage, Converter={StaticResource BoolToVis}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" BorderBrush="#DDD" BorderThickness="1" CornerRadius="6" Padding="10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.4*"/>
                        <ColumnDefinition Width="1.1*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Connection -->
                    <StackPanel Grid.Column="0" Orientation="Vertical">
                        <TextBlock FontSize="16" FontWeight="SemiBold" Text="Connection"/>
                        <WrapPanel Margin="0,8,0,0" VerticalAlignment="Center">
                            <TextBlock Text="COM:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <ComboBox Width="120" ItemsSource="{Binding ComPorts}" SelectedItem="{Binding SelectedComPort}" />
                            <Button Margin="8,0,0,0" Content="Refresh" Command="{Binding RefreshPortsCommand}" />
                        </WrapPanel>

                        <WrapPanel Margin="0,8,0,0">
                            <TextBlock Text="Baud:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBox Width="90" Text="{Binding BaudRate}" />
                            <TextBlock Text="Parity:" VerticalAlignment="Center" Margin="10,0,6,0"/>
                            <ComboBox Width="90" ItemsSource="{Binding ParityOptions}" SelectedItem="{Binding SelectedParity}" />
                            <TextBlock Text="Data:" VerticalAlignment="Center" Margin="10,0,6,0"/>
                            <TextBox Width="50" Text="{Binding DataBits}" />
                            <TextBlock Text="Stop:" VerticalAlignment="Center" Margin="10,0,6,0"/>
                            <ComboBox Width="90" ItemsSource="{Binding StopBitOptions}" SelectedItem="{Binding SelectedStopBits}" />
                        </WrapPanel>

                        <WrapPanel Margin="0,10,0,0">
                            <Button Width="120" Content="Connect" Command="{Binding ConnectCommand}" />
                            <Button Width="120" Margin="10,0,0,0" Content="Disconnect" Command="{Binding DisconnectCommand}" />
                            <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" Text="{Binding StatusText}"/>
                        </WrapPanel>
                    </StackPanel>

                    <!-- Timing + Start -->
                    <StackPanel Grid.Column="1" Orientation="Vertical" Margin="14,0,0,0">
                        <TextBlock FontSize="16" FontWeight="SemiBold" Text="Timing (ms)"/>
                        <WrapPanel Margin="0,8,0,0">
                            <TextBlock Text="Timeout:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBox Width="70" Text="{Binding ResponseTimeoutMs}" />
                            <TextBlock Text="Min gap:" VerticalAlignment="Center" Margin="10,0,6,0"/>
                            <TextBox Width="70" Text="{Binding InterCommandDelayMs}" />
                        </WrapPanel>
                        <TextBlock Margin="0,6,0,0" Foreground="#666"
                                   Text="Note: Device drops commands if sent too fast; Min gap is enforced by the app."/>

                        <Button Margin="0,12,0,0" Width="200" Content="Enter Operation" Command="{Binding EnterOperationCommand}" />
                    </StackPanel>
                </Grid>
            </Border>

            <TabControl Grid.Row="1" Margin="0,12,0,0">
                <TabItem Header="Parameters">
                    <Grid Margin="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <DataGrid Grid.Row="0"
                                  ItemsSource="{Binding Parameters}"
                                  SelectedItem="{Binding SelectedParameter}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  CanUserAddRows="False"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal"
                                  RowHeaderWidth="0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Address" Binding="{Binding AddressHex}" Width="90"/>
                                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/>
                                <DataGridTextColumn Header="Access" Binding="{Binding Access}" Width="90"/>
                                <DataGridTextColumn Header="Unit" Binding="{Binding Unit}" Width="120"/>
                                <DataGridTextColumn Header="Last (Dec)" Binding="{Binding LastValueDec}" Width="110"/>
                                <DataGridTextColumn Header="Last (Hex)" Binding="{Binding LastValueHex}" Width="110"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <WrapPanel Grid.Row="1" Margin="0,10,0,10">
                            <TextBlock VerticalAlignment="Center" Foreground="#666" Text="Select a parameter above, then add a usage entry:" />
                            <Button Margin="10,0,0,0" Width="120" Content="Add Usage" Command="{Binding AddUsageCommand}" />
                        </WrapPanel>

                        <Border Grid.Row="2" BorderBrush="#DDD" BorderThickness="1" CornerRadius="6" Padding="10">
                            <StackPanel>
                                <TextBlock FontSize="16" FontWeight="SemiBold" Text="Usage Entries"/>
                                <DataGrid Margin="0,10,0,0"
                                          ItemsSource="{Binding ParameterUsages}"
                                          AutoGenerateColumns="False"
                                          IsReadOnly="False"
                                          CanUserAddRows="False"
                                          HeadersVisibility="Column"
                                          GridLinesVisibility="Horizontal"
                                          RowHeaderWidth="0">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Address" Binding="{Binding AddressHex}" Width="90" IsReadOnly="True"/>
                                        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" IsReadOnly="True"/>
                                        <DataGridTemplateColumn Header="Mode" Width="110">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <ComboBox ItemsSource="{Binding Source={StaticResource UsageModes}}"
                                                              SelectedItem="{Binding Mode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="Action" Width="110">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <ComboBox ItemsSource="{Binding Source={StaticResource ActionTypes}}"
                                                              SelectedItem="{Binding Action, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="Poll (ms)" Binding="{Binding PollIntervalMs}" Width="90"/>
                                        <DataGridTextColumn Header="Write U16" Binding="{Binding WriteValueU16}" Width="110"/>
                                        <DataGridTemplateColumn Header="Remove" Width="70">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button Content="X"
                                                            Command="{Binding DataContext.RemoveUsageCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                            CommandParameter="{Binding}" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>
                    </Grid>
                </TabItem>

                <TabItem Header="Console Log">
                    <Grid Margin="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <WrapPanel Grid.Row="0">
                            <Button Content="Open log folder" Command="{Binding OpenLogFolderCommand}" />
                            <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" Foreground="#666" Text="{Binding CurrentLogFileHint}"/>
                        </WrapPanel>

                        <DataGrid Grid.Row="1" Margin="0,10,0,0"
                                  ItemsSource="{Binding LogEntries}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  CanUserAddRows="False"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal"
                                  RowHeaderWidth="0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Time" Binding="{Binding TimeLocal}" Width="160"/>
                                <DataGridTextColumn Header="Dir" Binding="{Binding Direction}" Width="60"/>
                                <DataGridTextColumn Header="RTT(ms)" Binding="{Binding RttMs}" Width="80"/>
                                <DataGridTextColumn Header="HEX" Binding="{Binding Hex}" Width="380"/>
                                <DataGridTextColumn Header="Parsed" Binding="{Binding Parsed}" Width="*"/>
                                <DataGridTextColumn Header="Result" Binding="{Binding Result}" Width="120"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>
            </TabControl>

            <Border Grid.Row="2" Margin="0,10,0,0" Padding="8" BorderBrush="#EEE" BorderThickness="1" CornerRadius="6">
                <TextBlock Foreground="#444" Text="{Binding FooterStatus}" />
            </Border>
        </Grid>

        <!-- Operation Page -->
        <Grid Visibility="{Binding IsOperationPage, Converter={StaticResource BoolToVis}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" BorderBrush="#DDD" BorderThickness="1" CornerRadius="6" Padding="10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.3*"/>
                        <ColumnDefinition Width="1.2*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Vertical">
                        <TextBlock FontSize="16" FontWeight="SemiBold" Text="Quick Control"/>
                        <WrapPanel Margin="0,8,0,0">
                            <Button Width="120" Content="Start" Command="{Binding StartCommand}" />
                            <Button Width="120" Margin="10,0,0,0" Content="Stop" Command="{Binding StopCommand}" />
                        </WrapPanel>
                        <WrapPanel Margin="0,8,0,0">
                            <Button Width="250" Content="Shutdown (Write 1 @0x000B)" Command="{Binding ShutdownCommand}" />
                        </WrapPanel>

                        <Border Margin="0,10,0,0" BorderBrush="#EEE" BorderThickness="1" Padding="8" CornerRadius="6">
                            <StackPanel>
                                <TextBlock FontWeight="SemiBold" Text="Set Speed Command (0x000A)"/>
                                <WrapPanel Margin="0,6,0,0">
                                    <TextBlock Text="Raw U16:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBox Width="90" Text="{Binding SpeedRawU16}" />
                                    <Button Margin="10,0,0,0" Width="120" Content="Write" Command="{Binding SetSpeedCommand}" />
                                </WrapPanel>
                                <TextBlock Margin="0,6,0,0" Foreground="#666"
                                           Text="Raw value is 2 bytes. If you want scaling (0.01Hz), we can add later once confirmed."/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Vertical" Margin="14,0,0,0">
                        <TextBlock FontSize="16" FontWeight="SemiBold" Text="Operation"/>
                        <WrapPanel Margin="0,8,0,0">
                            <CheckBox Content="Enable polling" IsChecked="{Binding PollEnabled}" />
                        </WrapPanel>
                        <WrapPanel Margin="0,10,0,0">
                            <Button Width="160" Content="Back to Settings" Command="{Binding ReturnToSettingsCommand}" />
                        </WrapPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <TabControl Grid.Row="1" Margin="0,12,0,0">
                <TabItem Header="Polling Read">
                    <Grid Margin="10">
                        <DataGrid ItemsSource="{Binding PollingReadUsagesView}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="False"
                                  CanUserAddRows="False"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal"
                                  RowHeaderWidth="0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Address" Binding="{Binding AddressHex}" Width="90" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" IsReadOnly="True"/>
                                <DataGridTemplateColumn Header="Chart" Width="70">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsChartSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Scale" Binding="{Binding ChartScale}" Width="80"/>
                                <DataGridTemplateColumn Header="Action" Width="120">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ComboBox ItemsSource="{Binding Source={StaticResource ActionTypes}}"
                                                      SelectedItem="{Binding Action, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Poll (ms)" Binding="{Binding PollIntervalMs}" Width="90"/>
                                <DataGridTextColumn Header="Write U16" Binding="{Binding WriteValueU16}" Width="120"/>
                                <DataGridTextColumn Header="Last (Dec)" Binding="{Binding LastValueDec}" Width="110" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Last (Hex)" Binding="{Binding LastValueHex}" Width="110" IsReadOnly="True"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>

                <TabItem Header="Polling Write">
                    <Grid Margin="10">
                        <DataGrid ItemsSource="{Binding PollingWriteUsagesView}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="False"
                                  CanUserAddRows="False"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal"
                                  RowHeaderWidth="0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Address" Binding="{Binding AddressHex}" Width="90" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" IsReadOnly="True"/>
                                <DataGridTemplateColumn Header="Action" Width="120">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ComboBox ItemsSource="{Binding Source={StaticResource ActionTypes}}"
                                                      SelectedItem="{Binding Action, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Poll (ms)" Binding="{Binding PollIntervalMs}" Width="90"/>
                                <DataGridTextColumn Header="Write U16" Binding="{Binding WriteValueU16}" Width="120"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>

                <TabItem Header="Single Parameters">
                    <Grid Margin="10">
                        <DataGrid ItemsSource="{Binding SingleUsagesView}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="False"
                                  CanUserAddRows="False"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal"
                                  RowHeaderWidth="0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Address" Binding="{Binding AddressHex}" Width="90" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" IsReadOnly="True"/>
                                <DataGridTemplateColumn Header="Action" Width="120">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ComboBox ItemsSource="{Binding Source={StaticResource ActionTypes}}"
                                                      SelectedItem="{Binding Action, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Write U16" Binding="{Binding WriteValueU16}" Width="120"/>
                                <DataGridTextColumn Header="Last (Dec)" Binding="{Binding LastValueDec}" Width="110" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Last (Hex)" Binding="{Binding LastValueHex}" Width="110" IsReadOnly="True"/>
                                <DataGridTemplateColumn Header="Send" Width="90">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="Send"
                                                    Command="{Binding DataContext.ExecuteSingleCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>

                <TabItem Header="Oscilloscope">
                    <Grid Margin="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Orientation="Horizontal">
                            <TextBlock VerticalAlignment="Center" Foreground="#666" Text="Select up to 5 polling read items (Chart checkbox) to plot." />
                        </StackPanel>

                        <Grid Grid.Row="1" Margin="0,10,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <ItemsControl Grid.Row="0" ItemsSource="{Binding ChartSeries}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,10,0">
                                            <Rectangle Width="12" Height="12" Fill="{Binding Stroke}" Margin="0,0,6,0"/>
                                            <TextBlock Text="{Binding Label}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Grid Grid.Row="1" Margin="0,8,0,0">
                                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Visibility="{Binding NoChartSeries, Converter={StaticResource BoolToVis}}"
                                           Foreground="#888" FontSize="16"
                                           Text="No chart series selected."/>
                                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                                    <Border BorderBrush="#333" BorderThickness="1" Padding="6" Background="#111">
                                        <Canvas Width="1000" Height="500" Background="#111">
                                            <Line X1="0" Y1="0" X2="0" Y2="499" Stroke="#444" StrokeThickness="1" />
                                            <Line X1="0" Y1="499" X2="999" Y2="499" Stroke="#444" StrokeThickness="1" />
                                            <Line X1="0" Y1="250" X2="999" Y2="250" Stroke="#2A2A2A" StrokeThickness="1" />
                                            <Line X1="500" Y1="0" X2="500" Y2="499" Stroke="#2A2A2A" StrokeThickness="1" />
                                            <TextBlock Canvas.Left="6" Canvas.Top="6" Foreground="#777" FontSize="12" Text="Y" />
                                            <TextBlock Canvas.Left="980" Canvas.Top="482" Foreground="#777" FontSize="12" Text="X" />
                                            <ItemsControl ItemsSource="{Binding ChartSeries}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <Canvas />
                                                    </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                <Polyline Points="{Binding Points}" Stroke="{Binding Stroke}" StrokeThickness="2"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Canvas>
                            </Border>
                                </ScrollViewer>
                            </Grid>
                        </Grid>
                    </Grid>
                </TabItem>

                <TabItem Header="Console Log">
                    <Grid Margin="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <WrapPanel Grid.Row="0">
                            <Button Content="Open log folder" Command="{Binding OpenLogFolderCommand}" />
                            <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" Foreground="#666" Text="{Binding CurrentLogFileHint}"/>
                        </WrapPanel>

                        <DataGrid Grid.Row="1" Margin="0,10,0,0"
                                  ItemsSource="{Binding LogEntries}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  CanUserAddRows="False"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal"
                                  RowHeaderWidth="0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Time" Binding="{Binding TimeLocal}" Width="160"/>
                                <DataGridTextColumn Header="Dir" Binding="{Binding Direction}" Width="60"/>
                                <DataGridTextColumn Header="RTT(ms)" Binding="{Binding RttMs}" Width="80"/>
                                <DataGridTextColumn Header="HEX" Binding="{Binding Hex}" Width="380"/>
                                <DataGridTextColumn Header="Parsed" Binding="{Binding Parsed}" Width="*"/>
                                <DataGridTextColumn Header="Result" Binding="{Binding Result}" Width="120"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>
            </TabControl>

            <Border Grid.Row="2" Margin="0,10,0,0" Padding="8" BorderBrush="#EEE" BorderThickness="1" CornerRadius="6">
                <TextBlock Foreground="#444" Text="{Binding FooterStatus}" />
            </Border>
        </Grid>
    </Grid>
</Window>
