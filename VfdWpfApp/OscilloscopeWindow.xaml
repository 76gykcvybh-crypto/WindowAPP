<Window x:Class="VfdWpfApp.OscilloscopeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Oscilloscope"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Foreground="#666"
                   Text="Select up to 5 polling read items (Chart checkbox) to plot." />

        <WrapPanel Grid.Row="1" Margin="0,8,0,8">
            <TextBlock VerticalAlignment="Center" Foreground="#666" Text="Time window (s):" />
            <TextBox Width="90" Margin="6,0,0,0" Text="{Binding ChartTimeWindowSeconds}" />
            <CheckBox Margin="20,0,0,0" VerticalAlignment="Center" Content="Pause"
                      IsChecked="{Binding ChartPaused, Mode=TwoWay}" />
        </WrapPanel>

        <DataGrid Grid.Row="2"
                  ItemsSource="{Binding ChartSelectedUsagesView}"
                  AutoGenerateColumns="False"
                  IsReadOnly="False"
                  CanUserAddRows="False"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  RowHeaderWidth="0"
                  Margin="0,0,0,8">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Address" Binding="{Binding AddressHex}" Width="90" IsReadOnly="True"/>
                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" IsReadOnly="True"/>
                <DataGridTextColumn Header="Scale" Binding="{Binding ChartScale, UpdateSourceTrigger=PropertyChanged}" Width="90"/>
                <DataGridTextColumn Header="Offset" Binding="{Binding ChartOffset, UpdateSourceTrigger=PropertyChanged}" Width="90"/>
            </DataGrid.Columns>
        </DataGrid>

        <Grid Grid.Row="3" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="260"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <ItemsControl Grid.Row="0" Grid.Column="0" ItemsSource="{Binding ChartSeries}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Margin="0,0,10,0">
                            <Rectangle Width="12" Height="12" Fill="{Binding Stroke}" Margin="0,0,6,0"/>
                            <TextBlock Text="{Binding Label}" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border Grid.Row="0" Grid.Column="1" Grid.RowSpan="2" Margin="12,0,0,0"
                    BorderBrush="#DDD" BorderThickness="1" CornerRadius="6" Padding="10">
                <StackPanel>
                    <TextBlock FontWeight="SemiBold" Text="Per-series scale" />
                    <ItemsControl ItemsSource="{Binding SeriesScaleLabels}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,6,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <Rectangle Width="12" Height="12" Fill="{Binding Stroke}" Margin="0,0,6,0"/>
                                        <TextBlock Text="{Binding Label}" />
                                    </StackPanel>
                                    <TextBlock Foreground="#666" FontSize="12"
                                               Text="{Binding Scale, StringFormat=Scale: {0:0.###}}"/>
                                    <TextBlock Foreground="#666" FontSize="12"
                                               Text="{Binding Offset, StringFormat=Offset: {0:0.###}}"/>
                                    <TextBlock Foreground="#666" FontSize="12"
                                               Text="{Binding Min, StringFormat=Min: {0:0.##}}"/>
                                    <TextBlock Foreground="#666" FontSize="12"
                                               Text="{Binding Max, StringFormat=Max: {0:0.##}}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Grid Grid.Row="1" Grid.Column="0" Margin="0,8,0,0">
                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="{Binding NoChartSeries, Converter={StaticResource BoolToVis}}"
                           Foreground="#888" FontSize="16"
                           Text="No chart series selected."/>
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                    <Border BorderBrush="#333" BorderThickness="1" Padding="6" Background="#111">
                        <Canvas Width="1000" Height="500" Background="#F7F7F7">
                            <ItemsControl ItemsSource="{Binding XAxisGridLines}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Canvas />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Line X1="{Binding X1}" Y1="{Binding Y1}" X2="{Binding X2}" Y2="{Binding Y2}"
                                              Stroke="#CFCFCF" StrokeThickness="1" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <ItemsControl ItemsSource="{Binding YAxisGridLines}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Canvas />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Line X1="{Binding X1}" Y1="{Binding Y1}" X2="{Binding X2}" Y2="{Binding Y2}"
                                              Stroke="#CFCFCF" StrokeThickness="1" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Line X1="0" Y1="0" X2="0" Y2="499" Stroke="#666" StrokeThickness="1.5" />
                            <Line X1="0" Y1="499" X2="999" Y2="499" Stroke="#666" StrokeThickness="1.5" />
                            <TextBlock Canvas.Left="6" Canvas.Top="6" Foreground="#555" FontSize="12" Text="Y" />
                            <TextBlock Canvas.Left="980" Canvas.Top="482" Foreground="#555" FontSize="12" Text="X" />
                            <ItemsControl ItemsSource="{Binding YAxisLabels}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Canvas />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Canvas.Left="{Binding Left}" Canvas.Top="{Binding Top}"
                                                   Foreground="#555" FontSize="11" Text="{Binding Text}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <ItemsControl ItemsSource="{Binding TimeAxisLabels}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Canvas />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Canvas.Left="{Binding Left}" Canvas.Top="{Binding Top}"
                                                   Foreground="#555" FontSize="11" Text="{Binding Text}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <ItemsControl ItemsSource="{Binding ChartSeries}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Canvas />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Polyline Points="{Binding Points}" Stroke="{Binding Stroke}" StrokeThickness="2"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Canvas>
                    </Border>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</Window>
